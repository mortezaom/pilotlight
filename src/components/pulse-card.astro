---
import { ActivityIcon, ArrowUpRightIcon } from "lucide-react";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { STATUS_LABELS } from "@/data/services-data";
import type { PublicService } from "@/data/services-storage";
import { PulseCardContent } from "./pulse-card-content";

type Props = { service: PublicService; pinned?: boolean };
const { service, pinned = false } = Astro.props;
const label = service.status ? STATUS_LABELS[service.status] : "Unknown";
---

<Card className="flex flex-col items-stretch justify-between">
  <CardHeader className="flex w-full flex-col items-stretch">
    <div class="flex w-full items-center justify-between">
      <CardTitle className="text-sm font-medium">
        {
          service.link && !pinned ? (
            <a
              class="border-border flex items-center gap-1 border-b-2 border-dashed transition-all hover:opacity-70"
              href={service.link}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span>{service.name}</span>
              <ArrowUpRightIcon className="size-4" />
            </a>
          ) : (
            service.name
          )
        }
      </CardTitle>
      {
        pinned ? (
          <ActivityIcon className="text-muted-foreground size-4" />
        ) : (
          <span class="text-muted-foreground text-sm font-bold">{label}</span>
        )
      }
    </div>
    {
      pinned && service.link && (
        <CardDescription>
          <a
            class="text-xs font-bold underline"
            href={service.link}
            rel="noopener noreferrer"
            target="_blank"
          >
            {service.link}
          </a>
        </CardDescription>
      )
    }
  </CardHeader>
  <PulseCardContent
    client:visible
    history={service.history}
    showStatus={pinned}
    status={service.status}
    uptime={service.uptime}
  />
</Card>
