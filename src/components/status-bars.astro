---
import type { PublicService } from "@/data/services-storage";
import { formatUtc } from "@/lib/format";

type Props = { history: PublicService["history"]; name: string };
const { history, name } = Astro.props;

const BARS = 50;
const bars = [...Array.from({ length: BARS - history.length }, () => null), ...history.slice(-BARS)];

const failed = history.filter((c) => c.status !== "up").length;
const summary =
  history.length === 0
    ? `${name}: no checks yet`
    : `${name}: last ${history.length} checks, ${history.length - failed} up, ${failed} failed`;
---

<!-- Height encodes status as well as color: failed checks stand out without color -->
<div aria-hidden="true" class="pl-bars">
  {
    bars.map((check) =>
      check ? (
        <span
          class="pl-bar"
          data-status={check.status}
          title={`${formatUtc(check.timestamp)} · ${check.status}${check.responseTime === null ? "" : ` · ${check.responseTime} ms`}`}
        />
      ) : (
        <span class="pl-bar" data-status="none" />
      )
    )
  }
</div>
<span class="sr-only">{summary}</span>
