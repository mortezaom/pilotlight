---
import StatusBars from "@/components/status-bars.astro";
import { STATUS_LABELS } from "@/data/services-data";
import { getServicesWithStatus, toPublicService } from "@/data/services-storage";
import Base from "@/layouts/base.astro";
import { formatAge, formatUtc } from "@/lib/format";
import { getSetting } from "@/lib/settings";
import { overallStatus } from "@/lib/status";

const [branding, settings, services] = await Promise.all([
  getSetting("branding"),
  getSetting("settings"),
  getServicesWithStatus().catch((error) => {
    console.error("Failed to fetch services:", error);
    return [];
  }),
]);
const visible = services.filter((s) => s.public).map(toPublicService);
const overall = overallStatus(visible.map((s) => s.status));

// Freshness: say when checks last ran, and warn when the cron seems stopped
const lastCheck = visible.map((s) => s.lastCheck).filter((t) => t !== undefined).sort().at(-1);
const intervalMs = (settings?.defaultMonitoringInterval ?? 5) * 60_000;
const stale = lastCheck !== undefined && Date.now() - Date.parse(lastCheck) > 3 * intervalMs;

const average = (values: number[]) =>
  values.length === 0 ? undefined : values.reduce((a, b) => a + b, 0) / values.length;
const uptime = average(visible.flatMap((s) => (s.uptime === undefined ? [] : [s.uptime])));
const latency = average(
  visible.flatMap((s) => (s.status === "up" && s.responseTime !== undefined ? [s.responseTime] : []))
);
const stats = [
  { label: "uptime · 24 h", value: uptime === undefined ? "—" : `${uptime.toFixed(2)}%` },
  { label: "avg response", value: latency === undefined ? "—" : `${Math.round(latency)} ms` },
  { label: "last check", value: lastCheck ? formatUtc(lastCheck).replace(/^.*, /u, "") : "—" },
];

const detail = (service: (typeof visible)[number]) => {
  const pct = service.uptime === undefined ? "no data" : `${service.uptime.toFixed(2)}%`;
  if (service.status && service.status !== "up") {
    return `${pct} · ${STATUS_LABELS[service.status].toLowerCase()}`;
  }
  return service.responseTime === undefined ? pct : `${pct} · ${service.responseTime} ms`;
};

const title = branding?.title ?? "Pilotlight";

// Served from Workers Cache: the Worker renders at most once a minute
Astro.response.headers.set("Cache-Control", "public, max-age=60, stale-while-revalidate=300");
---

<Base description={branding?.description} title={title} toasts={false}>
  <div class="flex min-h-svh flex-col">
    <section aria-labelledby="overall" class="pl-hero" data-level={overall.level}>
      <div class="pl-wrap relative flex flex-col gap-12 sm:gap-16">
        <header class="flex items-center justify-between gap-4">
          <a class="flex items-center gap-2 font-semibold" href="/">
            {branding?.imageUrl && <img alt="" class="size-6" height="24" src={branding.imageUrl} width="24" />}
            {title}
          </a>
          {lastCheck && <time class="pl-data text-xs opacity-70" datetime={lastCheck}>{formatUtc(lastCheck)}</time>}
        </header>

        <div class="pl-hero-body">
          <p class="pl-hero-chip">
            <span aria-hidden="true" class="pl-pulse" />
            {overall.detail}
          </p>
          <h1 class="pl-hero-title" id="overall">{visible.length === 0 ? "Nothing to report yet" : overall.label}</h1>
          {branding?.announcement && <p class="max-w-prose opacity-85">{branding.announcement}</p>}
          {stale && lastCheck && (
            <p class="font-semibold" role="status">
              Checks may have stopped: the last one ran {formatAge(lastCheck)} ago.
            </p>
          )}
          {visible.length > 0 && (
            <dl class="pl-stats">
              {stats.map((stat) => (
                <div class="flex flex-col gap-1">
                  <dt class="pl-label" style="color: inherit; opacity: 0.65">{stat.label}</dt>
                  <dd class="pl-data text-xl sm:text-2xl">{stat.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>

    <main class="pl-wrap flex flex-1 flex-col gap-10 py-10 sm:py-14">
      {
        visible.length === 0 ? (
          <p class="text-sub">No services are being monitored.</p>
        ) : (
          <section aria-labelledby="services-heading" class="flex flex-col gap-4">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-xl" id="services-heading">Services</h2>
              <span class="pl-label">last 50 checks</span>
            </div>
            <ul class="pl-list">
              {visible.map((service) => (
                <li class="pl-item">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    {service.link ? (
                      <a class="hover:text-main decoration-line font-medium underline underline-offset-4" href={service.link} rel="noopener noreferrer" target="_blank">{service.name}</a>
                    ) : (
                      <span class="font-medium">{service.name}</span>
                    )}
                    <span class:list={["pl-data text-sm", service.status && service.status !== "up" ? "text-down" : "text-sub"]}>{detail(service)}</span>
                  </div>
                  <StatusBars history={service.history} name={service.name} />
                </li>
              ))}
            </ul>
            <div aria-hidden="true" class="pl-data text-sub flex justify-between text-xs">
              <span>50 checks ago</span><span>now</span>
            </div>
          </section>
        )
      }

      <footer class="text-sub mt-auto text-xs">
        powered by <a class="hover:text-main underline underline-offset-4" href="https://github.com/mortezaom/pilotlight" rel="noopener noreferrer" target="_blank">pilotlight</a> · made by <a class="hover:text-main underline underline-offset-4" href="https://github.com/mortezaom" rel="noopener noreferrer" target="_blank">mortezaom</a>
      </footer>
    </main>
  </div>
</Base>
