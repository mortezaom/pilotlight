---
import { ServicesList } from "@/components/dashboard/services-list";
import { SettingsForm } from "@/components/dashboard/settings-form";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import Dashboard from "@/layouts/dashboard.astro";
---

<Dashboard title="Services">
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Services</h1>
      <p class="text-muted-foreground mt-2">
        Manage the monitored services and related settings
      </p>
    </div>
    <ServicesList client:load />
    <Card>
      <CardHeader><CardTitle>Settings</CardTitle></CardHeader>
      <CardContent><SettingsForm client:load /></CardContent>
    </Card>
  </div>
</Dashboard>
