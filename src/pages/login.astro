---
import AuthForm from "@/components/auth-form";
import { LogoVector } from "@/components/icons";
import Base from "@/layouts/base.astro";
import { getSetting } from "@/lib/settings";

const isInitialized = !!(await getSetting("admin"));
---

<Base title={isInitialized ? "Log in · Pilotlight" : "Set up · Pilotlight"}>
  <main class="mx-auto flex min-h-svh w-full max-w-sm flex-col justify-center gap-8 px-4 py-10">
    <div class="flex flex-col gap-3">
      <span class="text-main flex items-center gap-2 font-semibold"><LogoVector className="size-5" /> pilotlight</span>
      <h1 class="text-xl font-semibold">{isInitialized ? "Log in" : "Set up your dashboard"}</h1>
      {
        !isInitialized && (
          <p class="text-sub">
            Choose the admin email and password. The setup secret is the <code class="text-foreground">SETUP_SECRET</code> you added when deploying.
          </p>
        )
      }
    </div>
    <AuthForm client:load isInitialized={isInitialized} />
  </main>
</Base>
