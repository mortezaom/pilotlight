---
import { BellIcon, CpuIcon, LayoutDashboardIcon } from "lucide-react";
import { LogoutButton } from "@/components/dashboard/logout-button";
import { LogoVector } from "@/components/icons";
import { ThemeSwitcher } from "@/components/theme-switcher";
import Base from "@/layouts/base.astro";
import { cn } from "@/lib/utils";

type Props = { title: string };
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/u, "");

const items = [
  {
    description: "Status page branding",
    href: "/dashboard",
    icon: LayoutDashboardIcon,
    title: "Dashboard",
  },
  {
    description: "Manage services",
    href: "/dashboard/services",
    icon: CpuIcon,
    title: "Services",
  },
  {
    description: "Notification channels",
    href: "/dashboard/notifications",
    icon: BellIcon,
    title: "Notifications",
  },
];
const current = items.find((item) => item.href === path);
---

<Base title={`${title} · Pilotlight`}>
  <div class="flex h-screen overflow-hidden">
    <aside
      class="bg-background/50 hidden w-64 flex-col border-r backdrop-blur-sm md:flex"
    >
      <div class="flex h-16 items-center gap-3 border-b px-6">
        <a
          aria-label="Status page"
          class="flex size-10 items-center justify-center"
          href="/"
        >
          <LogoVector className="size-6" />
        </a>
        <div class="flex flex-col">
          <span class="text-lg font-semibold">Pilotlight</span>
          <span class="text-muted-foreground text-xs">Monitoring</span>
        </div>
      </div>
      <nav class="flex-1 space-y-2 p-4">
        {items.map((item) => (
  <a
    aria-current={item === current ? "page" : undefined}
    class={cn(
      "hover:bg-accent hover:text-accent-foreground flex items-center gap-3 rounded-lg px-4 py-3 transition-all duration-200",
      item === current &&
        "bg-primary text-primary-foreground hover:bg-primary/90 shadow-md"
    )}
    href={item.href}
  >
    <item.icon className="size-5 shrink-0" />
    <div class="flex min-w-0 flex-1 flex-col">
      <span class="text-sm font-medium">{item.title}</span>
      {item !== current && (
        <span class="text-muted-foreground truncate text-xs">
          {item.description}
        </span>
      )}
    </div>
  </a>
))}
      </nav>
      <div class="flex items-center justify-between border-t p-4">
        <ThemeSwitcher client:load />
        <LogoutButton client:load />
      </div>
    </aside>

    <div class="flex flex-1 flex-col overflow-hidden">
      <header
        class="bg-background/95 sticky top-0 z-50 flex h-16 items-center justify-between border-b px-4 backdrop-blur-sm md:hidden"
      >
        <div class="flex items-center gap-3">
          <a
            aria-label="Status page"
            class="flex size-10 items-center justify-center"
            href="/"
          >
            <LogoVector className="size-5" />
          </a>
          <span class="text-sm font-semibold"
            >{current?.title ?? "Dashboard"}</span
          >
        </div>
        <div class="flex items-center gap-1">
          <ThemeSwitcher client:load />
          <LogoutButton client:load />
        </div>
      </header>

      <main class="flex-1 overflow-y-auto">
        <div class="mx-auto max-w-7xl p-4 pb-20 md:p-6 md:pb-8 lg:p-8">
          <slot />
        </div>
      </main>

      <nav
        class="bg-background/95 fixed right-0 bottom-0 left-0 z-50 flex h-16 items-center justify-around border-t px-2 backdrop-blur-sm md:hidden"
      >
        {items.map((item) => (
  <a
    aria-current={item === current ? "page" : undefined}
    class={cn(
      "flex h-full flex-1 flex-col items-center justify-center gap-1 transition-colors duration-200",
      item === current
        ? "text-primary"
        : "text-muted-foreground hover:text-foreground"
    )}
    href={item.href}
  >
    <item.icon className="size-5" />
    <span class="text-xs font-medium">{item.title}</span>
  </a>
))}
      </nav>
    </div>
  </div>
</Base>
