---
import { LogoutButton } from "@/components/dashboard/logout-button";
import { LogoVector } from "@/components/icons";
import Base from "@/layouts/base.astro";

type Props = { title: string; description?: string };
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/u, "");

const items = [
  { href: "/dashboard", label: "overview" },
  { href: "/dashboard/services", label: "services" },
  { href: "/dashboard/notifications", label: "notifications" },
  { href: "/dashboard/settings", label: "settings" },
];
---

<Base title={`${title} · Pilotlight`}>
  <header class="border-line border-b">
    <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
      <a class="text-main flex items-center gap-2 font-semibold" href="/dashboard">
        <LogoVector className="size-5" />
        pilotlight
      </a>
      <nav aria-label="Dashboard" class="order-last flex w-full [scrollbar-width:none] gap-5 overflow-x-auto sm:order-none sm:w-auto">
        {
          
          items.map((item) => (
            <a
              aria-current={item.href === path ? "page" : undefined}
              class="text-sub hover:text-foreground aria-[current=page]:text-foreground decoration-main whitespace-nowrap underline-offset-8 aria-[current=page]:underline"
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex items-center gap-1">
        <a class="text-sub hover:text-foreground px-2" href="/" target="_blank">status page ↗</a>
        <LogoutButton client:load />
      </div>
    </div>
  </header>
  <main class="mx-auto flex max-w-4xl flex-col gap-8 px-4 py-8">
    <div class="flex flex-col gap-1">
      <h1 class="text-xl font-semibold">{title}</h1>
      {description && <p class="text-sub">{description}</p>}
    </div>
    <slot />
  </main>
</Base>
