---
import "@/styles.css";
import { Toaster } from "@/components/ui/sonner";
import { getSetting } from "@/lib/settings";
import { DEFAULT_THEMES, fontsHref, themeCss, themeFontsHref } from "@/lib/themes";

// toasts: off for the public status page, which then ships no JavaScript
type Props = { title: string; description?: string; toasts?: boolean };
const { title, description = "Uptime monitoring and status page", toasts = true } = Astro.props;

// The admin's theme pair; the visitor's OS setting picks light or dark
const settings = await getSetting("settings").catch(() => null);
const darkId = settings?.darkTheme ?? DEFAULT_THEMES.dark;
const lightId = settings?.lightTheme ?? DEFAULT_THEMES.light;
const theme = themeCss(darkId, lightId);
// the theme picker previews every font; other pages load only the pair's
const fonts = Astro.url.pathname.startsWith("/dashboard/settings") ? fontsHref() : themeFontsHref(darkId, lightId);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content={description} name="description" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href={fonts} rel="stylesheet" />
    <style set:html={theme}></style>
  </head>
  <body class="antialiased">
    <slot />
    {toasts && <Toaster client:idle />}
  </body>
</html>
