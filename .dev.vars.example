# Local development secrets: copy to .dev.vars (git-ignored).
# In production SESSION_SECRET and ENCRYPTION_KEY are generated by the deploy
# workflow; only SETUP_SECRET is a repository secret.

# One-time secret that lets you create the admin account on /login
SETUP_SECRET=change-me

# Signs login sessions. Changing it logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts notification channel credentials. Changing it makes saved
# channels unreadable (they must be re-entered).
ENCRYPTION_KEY=change-me-to-another-long-random-string
